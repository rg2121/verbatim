# Copy to .env and edit. Real environment variables override anything here.
# .env is gitignored because it may hold an API key; this template is not.

# ---------------------------------------------------------------- storage ---
# The database is the source of truth. Everything else is derived from it.
VERBATIM_STATE_PATH=data/corpus.db
VERBATIM_PDF_DIR=data/pdfs
VERBATIM_CHUNKS_PATH=data/chunks.jsonl
VERBATIM_PAPERS_SNAPSHOT_PATH=data/papers.json

# --------------------------------------------------------------- chunking ---
# Both values are part of the chunker fingerprint: changing either causes
# affected PDFs to be re-chunked on the next `chunk` run.
VERBATIM_CHUNK_SIZE=1200
VERBATIM_CHUNK_OVERLAP=200

# -------------------------------------------------------------- retrieval ---
# Changing the embedding model does not invalidate existing vectors; they are
# stored per model, so both sets can coexist. Re-run `embed` after changing it.
VERBATIM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VERBATIM_SEARCH_LIMIT=10
VERBATIM_ASK_PASSAGES=8
VERBATIM_ASK_MAX_PER_PAPER=3

# ------------------------------------------------------------- generation ---
# ollama keeps everything on this machine; the hosted backend calls a remote API.
VERBATIM_ANSWER_BACKEND=ollama

# Local generation. Leave OLLAMA_MODEL empty to use the first pulled model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=600

# Cloud generation, used only with VERBATIM_ANSWER_BACKEND=hosted.
VERBATIM_HOSTED_MODEL=hosted-model
# HOSTED_API_KEY=your-key-here

# ----------------------------------------------------------------- arXiv ----
# Seconds between OAI-PMH licence lookups. arXiv asks callers to pace requests.
VERBATIM_LICENSE_LOOKUP_DELAY=3

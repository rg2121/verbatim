# Copy to .env and edit. Real environment variables override anything here.
# .env is gitignored so local paths and hosts stay out of the repository.

# ---------------------------------------------------------------- storage ---
# The database is the source of truth. Everything else is derived from it.
VERBATIM_STATE_PATH=data/corpus.db
VERBATIM_PDF_DIR=data/pdfs
VERBATIM_CHUNKS_PATH=data/chunks.jsonl
VERBATIM_PAPERS_SNAPSHOT_PATH=data/papers.json

# Where `distill` writes generated training examples. Under data/, so it stays
# private: the dataset quotes papers directly.
VERBATIM_DISTILL_PATH=data/distill/dataset.jsonl

# --------------------------------------------------------------- chunking ---
# Both values are part of the chunker fingerprint: changing either causes
# affected PDFs to be re-chunked on the next `chunk` run.
VERBATIM_CHUNK_SIZE=1200
VERBATIM_CHUNK_OVERLAP=200

# Seconds a single paper's layout extraction may take before it is skipped.
VERBATIM_EXTRACTION_TIMEOUT=180

# -------------------------------------------------------------- retrieval ---
# Changing the embedding model does not invalidate existing vectors; they are
# stored per model, so both sets can coexist. Re-run `embed` after changing it.
VERBATIM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where downloaded models are kept; outside the system temp folder, which the OS clears.
VERBATIM_MODEL_CACHE=~/.cache/verbatim/models
VERBATIM_SEARCH_LIMIT=10
VERBATIM_ASK_PASSAGES=8
VERBATIM_ASK_MAX_PER_PAPER=3
# Reorders the top 50 fused passages where keyword and vector search disagree
# on the top paper, never on a "what is X" question: colbert (measured best,
# about 130 MB, downloaded on first use), cross, or off.
VERBATIM_RERANKER=colbert

# Embed each passage with its paper title and section heading in front of it.
# Off until measured on this corpus. Changing it means re-running `embed`.
VERBATIM_EMBED_WITH_CONTEXT=0

# ------------------------------------------------------------- generation ---
# Every model is reached through Ollama; there is no other backend and no API
# key. A local model keeps the corpus on this machine. A model whose name ends
# `-cloud` is served by Ollama's infrastructure, so each prompt's passages leave
# it - and the corpus is other people's papers, so choose that deliberately.
# Leave OLLAMA_MODEL empty to use the first pulled local model; a `-cloud`
# model is only ever used when named here.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=600

# How the model returns answers: "lines" (the flat ANSWER/CITE protocol every
# model tested follows) or "tools" (Ollama tool calling). Measured no better.
VERBATIM_ANSWER_PROTOCOL=lines

# ----------------------------------------------------------------- arXiv ----
# Seconds between OAI-PMH licence lookups. arXiv asks callers to pace requests.
VERBATIM_LICENSE_LOOKUP_DELAY=3

# ------------------------------------------------------------------ sync ---
# arXiv caps a single request, so larger corpora are paged. The delay is what
# arXiv asks callers to leave between requests.
VERBATIM_SYNC_LIMIT=1000
VERBATIM_SYNC_PAGE_SIZE=100
VERBATIM_SYNC_DELAY=3

# arXiv is variable and returns 503 under load; a long ingest needs retries.
VERBATIM_HTTP_TIMEOUT=90
VERBATIM_HTTP_RETRIES=4
VERBATIM_HTTP_BACKOFF=5
# PDFs are larger than metadata; the cap stops one huge file eating memory.
VERBATIM_PDF_TIMEOUT=120
VERBATIM_PDF_MAX_BYTES=200000000
# Seconds between PDF requests, so a bulk download stays polite.
VERBATIM_DOWNLOAD_DELAY=3
# PDFs held in memory at once while chunking; bounds peak memory.
VERBATIM_CHUNK_BATCH_SIZE=100
# The retrieval answer key (committed, unlike the corpus).
VERBATIM_EVAL_PATH=evals/retrieval.jsonl
# Warn when the passages' subject is this far from the question.
VERBATIM_SUBJECT_WARN_BELOW=0.65
# arXiv HTML renderings, preferred over PDFs where they exist.
VERBATIM_HTML_DIR=data/html

# ---------------------------------------------------------------- logging ---
# Structured events go to stderr. "text" for reading, "json" for collecting.
VERBATIM_LOG_FORMAT=text
VERBATIM_LOG_LEVEL=info
